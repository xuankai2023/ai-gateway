# Console BFF 配置（复制为 .env.local 后填写，切勿提交真实值）

# 管理面地址：BFF 服务端访问，浏览器永远拿不到 token
ADMIN_API_URL=http://127.0.0.1:8082
ADMIN_API_TOKEN=change-me

# 会话签名密钥：至少 32 字节随机串
CONSOLE_SESSION_SECRET=change-me-to-a-long-random-string

# 控制台用户（JSON 数组）。password_hash 由 `pnpm hash-password <密码>` 生成
CONSOLE_USERS='[{"username":"admin","password_hash":"scrypt:<salt>:<hash>","role":"admin"}]'
